{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "luxeperfume",
  "compatibility_date": "2026-08-26",
  "main": "worker.js",
  // Keeps console logs (order failures, Turnstile rejections) in the dashboard's Logs tab.
  "observability": { "enabled": true },
  // 10 API calls per minute per visitor IP, per route (see lib/abuse-protection.js).
  // Kept generous because cruise-ship and hotel guests can share one IP.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Daily at 08:00 UTC (4 AM in St. Thomas): deletes checkouts older than two
  // weeks (see lib/checkout.js).
  "triggers": { "crons": ["0 8 * * *"] },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
